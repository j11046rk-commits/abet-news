# Supabase — プロジェクト設定 → API から取得する
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# service role キー。サーバー側（Route Handler）でのみ使用する。
# NEXT_PUBLIC_ を付けないこと。クライアントバンドルに入れないこと。
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ログインIDを Supabase Auth の email に変換するときの内部ドメイン。
# 利用者には見せない。実在しないドメインを使う。
AUTH_EMAIL_DOMAIN=theoldman.local
