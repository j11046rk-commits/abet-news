---
import site from '../../data/site.json';
import BigPoints from './BigPoints.astro';
const f = site.特長;
/*
 * しっぽり亭の楽しみ方。大きな一言＋名前＋ひとことの升目だけ（BigPoints.astro）。
 * 写真の切り抜き・アイコン・長い説明は「ダサい・見にくい・写真が荒い」と店主指摘で外した（2026-11-12）。
 */
const items = f.items.map((x) => ({ big: x.大きく, name: x.名前, sub: x.ひとこと }));
---
<section class="section" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section__head">
      <p class="section__kicker">Our Style</p>
      <h2 class="section__title" id="features-title">{f.見出し}</h2>
      <p class="section__lead">{f.リード}</p>
    </div>
    <BigPoints items={items} />
    {f.ドリンク && f.ドリンク.length > 0 && (
      <p class="drinks"><span class="drinks__label">ドリンク</span><span>{f.ドリンク.join('・')}</span></p>
    )}
  </div>
</section>

<style>
  .drinks { max-width: 900px; margin: 1.2rem auto 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.3rem 0.9rem; font-size: 0.88rem; color: var(--text); text-align: center; }
  .drinks__label { font-family: var(--font-serif); color: var(--gold-soft); letter-spacing: 0.1em; }
</style>
