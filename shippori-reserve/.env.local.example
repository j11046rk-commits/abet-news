# Supabase（プロジェクト作成後に Settings > API からコピー）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ★ サーバー専用。ブラウザに絶対に出さない（アカウント発行・パスワード再発行でのみ使う）
SUPABASE_SERVICE_ROLE_KEY=

# ログインID → Supabase Auth の email に変換するときのドメイン。
# 実在しないドメインを使う（メールは送らない）。
AUTH_EMAIL_DOMAIN=shipporitei.local

# Phase 3（公開予約フォーム）で使う。Phase 1 では未設定でよい。
PUBLIC_FORM_ORIGIN=https://shipporitei.jp
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# アクセス計測（GA4）。お客様向けの予約ページ（/yoyaku）にだけ入る。
# 公式サイト（shipporitei.jp）と同じ測定IDを入れると、
# 「HPを見た人が予約ページに来て、何人が予約まで進んだか」が1本で追える。
# 空なら計測タグは入らない。スタッフ用の画面には入れていない。
NEXT_PUBLIC_GA_ID=

# ネット予約が入ったときのLINE通知。
# 週次レポート（別リポジトリ shippori-report）と同じ公式アカウント・同じグループへ送る。
# 値は古賀さんのMacの ~/.config/shippori-report/app.env に入っているものと同じ。
#   LINE_CHANNEL_ACCESS_TOKEN … 公式アカウントのチャンネルアクセストークン
#   LINE_TARGET_ID            … 送信先のグループID（Cで始まる）
# どちらか欠けていれば通知は送らない（予約そのものは通常どおり動く）。
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=

# Phase 5（LINEからの受信）で使う。Phase 1 では未設定でよい。
LINE_CHANNEL_SECRET=
