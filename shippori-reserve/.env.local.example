# Supabase（プロジェクト作成後に Settings > API からコピー）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ★ サーバー専用。ブラウザに絶対に出さない（アカウント発行・パスワード再発行でのみ使う）
SUPABASE_SERVICE_ROLE_KEY=

# ログインID → Supabase Auth の email に変換するときのドメイン。
# 実在しないドメインを使う（メールは送らない）。
AUTH_EMAIL_DOMAIN=shipporitei.local

# Phase 3（公開予約フォーム）で使う。Phase 1 では未設定でよい。
PUBLIC_FORM_ORIGIN=https://shipporitei.jp
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Phase 5（LINE連携）で使う。Phase 1 では未設定でよい。
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# GET /api/public/business-day の合言葉。
# ストーリー告知リマインダー（shippori-story-reminder/）と同じ値を入れる。
# 未設定なら同エンドポイントは常に 401。
BUSINESS_DAY_TOKEN=
