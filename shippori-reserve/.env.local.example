# このファイルは「本番を組み直すときの完全な一覧」。
# ここに無い変数をコードで参照しない・ここにある変数は用途を書く。
# （実際の値は Vercel の Environment Variables に入っている）

# ── Supabase（プロジェクト作成後に Settings > API からコピー）──────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ★ サーバー専用。ブラウザに絶対に出さない
SUPABASE_SERVICE_ROLE_KEY=

# ログインID → Supabase Auth の email に変換するときのドメイン。
# 実在しないドメインを使う（メールは送らない）。
AUTH_EMAIL_DOMAIN=shipporitei.local

# 公開予約フォームの置き場所（CORSの許可元）
PUBLIC_FORM_ORIGIN=https://shipporitei.jp
# 通知の中のリンクに使う自分のURL（未設定なら https://yoyaku.shipporitei.jp）
NEXT_PUBLIC_APP_URL=

# ── 定期実行と外部連携の合言葉 ─────────────────────────────
# Vercel Cron が /api/cron/* を呼ぶときの合言葉（無いと誰でも叩ける）
CRON_SECRET=
# 週次バックアップ（Macの weekly-backup.mjs）が /api/cron/backup を呼ぶ合言葉
BACKUP_TOKEN=
# 売上取り込み（Macの ingest.mjs）が /api/sales/ingest を呼ぶ合言葉
SALES_INGEST_TOKEN=
# 集計の読み出し /api/insights の合言葉
INSIGHTS_TOKEN=

# ── SMS認証（Twilio Verify）──────────────────────────────
# 3つ全部そろって初めてSMS認証がオンになる（欠けていれば認証なしで通る）
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# ── アクセス計測（GA4）。お客様向けの /yoyaku にだけ入る ─────────
NEXT_PUBLIC_GA_ID=

# ── LINE（公式アカウントは2つある。取り違えると届かない）──────────
# ① しっぽり亭レポート … 店の中向け。週次レポートと同じグループへ通知する
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=
# ② しっぽり亭 家庭料理おばんざい居酒屋 … お客様向け。友だち追加してもらうのはこちら
#   （webhookの署名検証も②のチャネルシークレットで行う）
LINE_CUSTOMER_CHANNEL_ACCESS_TOKEN=
LINE_CUSTOMER_CHANNEL_SECRET=
# LINEログイン（②と同じプロバイダーに作ること。別だと友だち追加が同時にできない）
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=
# 静かな日のクーポン配信（毎日13時・予約ゼロの日だけ）。1にすると動き出す
QUIET_COUPON_ENABLED=
# LINE公式アカウントの管理画面で作ったクーポンのURL（無ければ画面提示で成立）
QUIET_COUPON_URL=
# 公式LINE（お客様向け）の友だち追加URL（lin.ee のリンク）。予約完了画面の導線に使う
NEXT_PUBLIC_LINE_FRIEND_URL=
